      "annotations": ["@AndroidEntryPoint"],
      "viewmodel_access": "private val viewModel: TriviaViewModel by viewModels()",
      "hardcoded_values": {
        "questionText": "Which of these players currently has the most points?"
      },
      "state_routing": [
        "viewModel.isLoading -> CircularProgressIndicator centered in Box",
        "viewModel.loadError -> Error text in red",
        "viewModel.choices.isEmpty() -> 'Unable to load question' text",
        "else -> TriviaQuestionScreen with full ViewModel state delegation"
      ],
      "scoreColor_logic": {
