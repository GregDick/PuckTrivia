      "path": "app/src/main/java/com/example/pucktrivia/TriviaQuestionScreen.kt",
      "lines": 99,
      "complexity": "medium",
      "role": "main_ui_screen",
      "description": "Stateless composable rendering the trivia question UI. Displays score, question text, answer choice buttons with color feedback, correct/incorrect result text, and Next button. This is the primary file for UI modifications.",
      "composable_signature": {
        "name": "TriviaQuestionScreen",
        "parameters": [
          "score: Int",
          "scoreColor: Color",
          "questionText: String",
          "choices: List<SkaterStatLeader>",
          "selectedPlayerId: Int?",
          "correctPlayerId: Int",
          "answered: Boolean",
          "isCorrect: Boolean",
          "onAnswerSelected: (Int) -> Unit",
          "onNextRound: () -> Unit",
          "modifier: Modifier = Modifier"
        ]
      },
      "ui_structure": {
        "root": "Column (fillMaxSize, padding 24dp horizontal, Arrangement.Center, CenterHorizontally)",
        "children": [
          "Text - 'Score: $score' (titleMedium, dynamic scoreColor, fillMaxWidth, bottom padding 16dp)",
          "Text - questionText (headlineSmall, bottom padding 24dp)",
          "Text - 'Correct!'/'Incorrect!' (titleLarge, conditional on answered, CorrectGreen or error color, bottom padding 16dp)",
          "ForEach choices -> Button (fillMaxWidth, vertical padding 6dp, disabled when answered, color-coded)",
          "  -> Text '${player.firstName} ${player.lastName}' (bodyLarge)",
          "OutlinedButton - 'Next' (conditional on answered, fillMaxWidth, top padding 24dp)"
        ]
      },
      "custom_colors": {
        "CorrectGreen": "Color(0xFF4CAF50) - internal val at file level, used for correct answer button and 'Correct!' text"
      },
      "button_color_logic": {
        "not_answered": "MaterialTheme.colorScheme.primary",
        "correct_player_after_answer": "CorrectGreen",
        "selected_wrong_player": "MaterialTheme.colorScheme.error",
        "other_players_after_answer": "MaterialTheme.colorScheme.primary"
      },
      "button_text_current": "${player.firstName} ${player.lastName}",
      "available_player_fields_for_display": ["firstName", "lastName", "teamAbbrev", "sweaterNumber", "position", "value"]
    },
    {
      "path": "app/src/main/java/com/example/pucktrivia/TriviaViewModel.kt",
      "lines": 139,
      "complexity": "high",
      "role": "state_management_and_data_fetching",
      "description": "HiltViewModel that fetches NHL skater stats via OkHttp, parses JSON, manages trivia game state. Injected with OkHttpClient, statsUrl, and ioDispatcher via Hilt.",
      "class_annotation": "@HiltViewModel",
      "constructor_injection": ["OkHttpClient", "@StatsUrl String", "@IoDispatcher CoroutineDispatcher"],
      "state_fields": {
        "statsData": {"type": "Map<String, List<SkaterStatLeader>>", "mutable": "mutableStateOf", "private_set": true},
        "isLoading": {"type": "Boolean", "mutable": "mutableStateOf", "private_set": true, "initial": true},
        "loadError": {"type": "Boolean", "mutable": "mutableStateOf", "private_set": true, "initial": false},
        "score": {"type": "Int", "mutable": "mutableIntStateOf", "private_set": true, "initial": 0},
        "roundNumber": {"type": "Int", "mutable": "mutableIntStateOf", "private_set": true, "initial": 0},
        "usedPlayerIds": {"type": "Set<Int>", "mutable": "mutableStateOf", "private_set": true},
        "selectedPlayerId": {"type": "Int?", "mutable": "mutableStateOf", "private_set": true},
        "choices": {"type": "List<SkaterStatLeader>", "mutable": "mutableStateOf", "private_set": true},
        "correctPlayer": {"type": "SkaterStatLeader?", "mutable": "mutableStateOf", "private_set": true}
      },
      "derived_properties": {
        "answered": "selectedPlayerId != null",
        "isCorrect": "selectedPlayerId == correctPlayer?.id"
      },
      "public_methods": {
        "selectAnswer(playerId: Int)": "Records selection; +100 score if correct, reset to 0 if wrong",
        "nextRound()": "Increments roundNumber, clears selectedPlayerId, calls prepareRound()"
      },
      "private_methods": {
        "fetchStats()": "Called in init{}, launches coroutine to fetch and parse, then prepareRound()",
        "prepareRound()": "Picks 3 shuffled players from 'points' category, avoids reuse, sets correctPlayer = maxBy value",
        "fetchSkaterStats()": "suspend fun, OkHttp GET + JSON parsing on ioDispatcher"
      },
      "scoring_logic": {
        "correct_answer": "score += 100",
        "wrong_answer": "score = 0"
      },
      "api_details": {
        "url": "https://api-web.nhle.com/v1/skater-stats-leaders/current?limit=-1",
        "method": "GET",
        "response_format": "JSON object with stat category keys (e.g. 'points') -> arrays of player objects",
        "currently_used_category": "points"
      }
    },
