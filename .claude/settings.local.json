{
  "permissions": {
    "allow": [
      "WebFetch(domain:api-web.nhle.com)",
      "WebFetch(domain:github.com)",
      "Bash(./gradlew assembleDebug)",
      "Bash(brew search:*)",
      "Bash(brew list:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ktfmt.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
