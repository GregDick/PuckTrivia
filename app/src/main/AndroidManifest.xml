<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional XR support. required="false" is what keeps the app installable on
      phones and tablets: the spatial layout is selected at runtime by
      isSpatialUiEnabled(), never by device type.
    -->
    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="false" />

    <application
        android:name=".PuckTriviaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuckTrivia">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PuckTrivia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Launch windowed in Home Space; the player expands into Full Space with
              the in-app toggle. Stated explicitly rather than relying on the
              platform default so the intent is visible in the manifest.
            -->
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_HOME_SPACE" />
        </activity>
    </application>

</manifest>