<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Platform-neutral half of the manifest. Everything that names an XR stack — the Android XR
      feature and MainActivity, or the Horizon OS SDK range and the immersive activity — lives in
      src/mobile and src/quest and is merged in per flavor.

      Note there is no <activity> here at all: each flavor declares its own LAUNCHER. Leaving one
      here would merge into both flavors and give the quest build two launcher entries.
    -->
    <application
        android:name=".PuckTriviaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuckTrivia" />

</manifest>
